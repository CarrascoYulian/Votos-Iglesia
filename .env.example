# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase.
# Ambos valores son públicos (protegidos por RLS). NUNCA pongas aquí la clave service_role.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Opcional: URL pública del sitio (para los enlaces de los correos de confirmación).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
